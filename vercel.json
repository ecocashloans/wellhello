    { "source": "/v2/api/user/:viewerId/favorites", "destination": "/api/profile?p=favorites" },
    { "source": "/v2/api/user/:viewerId/favorite/:profileId", "destination": "/api/profile?p=favorite" },
    { "source": "/v2/api/user/:viewerId/flirt/:profileId", "destination": "/api/profile?p=flirt" },
