{
  "rewrites": [
    { "source": "/v2/api/registration", "destination": "/api/registration" },
    { "source": "/v2/api/login", "destination": "/api/login" },
    { "source": "/v2/api/newLogin", "destination": "/api/newlogin" },
    { "source": "/v2/api/autoLogin", "destination": "/api/autologin" },
    { "source": "/v2/api/user/:id/homeAds", "destination": "/api/homeads" },
    { "source": "/v2/api/profile/viewer/:id/cards", "destination": "/api/cards" },
    { "source": "/v2/api/user/:id/email/activation", "destination": "/api/emailactivation" },
    { "source": "/v2/api/profile/viewer/:viewerId/getprofile/:profileId", "destination": "/api/profile?p=getprofile&profileId=:profileId" },
    { "source": "/v2/api/profile/viewer/:viewerId/hotties/home", "destination": "/api/profile?p=hotties" },
    { "source": "/v2/api/profile/viewer/:viewerId/hotties", "destination": "/api/profile?p=hottiesgallery" },
    { "source": "/v2/api/profile/viewer/:viewerId/newphotos", "destination": "/api/profile?p=newphotos" },
