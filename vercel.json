    { "source": "/v2/api/chat/token", "destination": "/api/profile?p=chattoken" },
    { "source": "/v2/(.*)", "destination": "https://wellhello.com/v2/$1" },
    { "source": "/img/(.*)", "destination": "https://static.wellhello.com/img/$1" },
    { "source": "/(.*)", "destination": "/api/index" }
