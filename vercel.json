{
  "rewrites": [
    { "source": "/v2/api/registration", "destination": "/api/registration" },
    { "source": "/v2/api/login", "destination": "/api/login" },
    { "source": "/v2/api/newLogin", "destination": "/api/newlogin" },
    { "source": "/v2/api/autoLogin", "destination": "/api/autologin" },
    { "source": "/v2/(.*)", "destination": "https://wellhello.com/v2/$1" },
    { "source": "/img/(.*)", "destination": "https://wellhello.com/img/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}